def limpiar_registro_sensor(registro_raw: dict) -> dict:
    
    sensor_id_raw = registro_raw.get("sensor_id", "DESCONOCIDO")
    sensor_id_limpio = sensor_id_raw.strip()
    
    temp_cruda = str(registro_raw.get("temperatura", "0"))
    temp_limpia = temp_cruda.replace("C", "").replace("°", "").strip()
    temperatura_float = float(temp_limpia)
    
    ubicacion = registro_raw.get("ubicacion", "Planta Desconocida")
    
    if not ubicacion or ubicacion.strip() == "":
        ubicacion = "Planta Desconocida"
    else:
        ubicacion = ubicacion.strip()
        
    return {
        "sensor_id": sensor_id_limpio,
        "temperatura": temperatura_float,
        "ubicacion": ubicacion
    }

def generar_resumen_sensores(lista_sensores_limpios: list, umbral_temperatura: float) -> tuple:

    if not lista_sensores_limpios:
        return [], 0.0
        
    sensores_alerta = []
    suma_temperaturas = 0.0
    total_sensores = len(lista_sensores_limpios)
    
    for sensor in lista_sensores_limpios:
        temp_actual = sensor["temperatura"]
        suma_temperaturas += temp_actual
        
    
        if temp_actual > umbral_temperatura:
            sensores_alerta.append(sensor["sensor_id"])
            
    promedio_temperatura = suma_temperaturas / total_sensores
    
    return sensores_alerta, promedio_temperatura

